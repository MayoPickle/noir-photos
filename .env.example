NOIR_ENV=development
NOIR_SECRET_KEY=change-me-use-a-long-random-secret
NOIR_DATABASE_URL=postgresql+psycopg://noir:noir@postgres:5432/noir
NOIR_CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:8080,http://127.0.0.1:3000
NOIR_AUTO_CREATE_TABLES=true

NOIR_OBJECT_STORAGE_BACKEND=minio
NOIR_S3_ENDPOINT_URL=http://minio:9000
NOIR_S3_ACCESS_KEY_ID=noir
NOIR_S3_SECRET_ACCESS_KEY=noirpassword
NOIR_S3_BUCKET=noir-photos
NOIR_S3_REGION=us-east-1
NOIR_S3_PUBLIC_BASE_URL=http://localhost:9000
